# Copy to .env and fill in the providers you actually use.
# setup.sh does this automatically if .env is missing.
#
# No key is strictly required to load the code (secrets resolve late, by
# env-var name, at the call boundary) — set the ones for the providers you
# run. The standing production model is deepseek-v4-flash (DEEPSEEK_API_KEY).
# Anthropic models were retired from the pool 2026-07-21; engine support
# remains, so the key still works if an anthropic model is ever re-added.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
QWEN_US_API_KEY=
XAI_GROK_API_KEY=
OLLAMA_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# LLM_TIMEOUT_SECONDS — connect/write/pool phases (getting the request out
# the door). Default 120.
LLM_TIMEOUT_SECONDS=120
# LLM_INACTIVITY_TIMEOUT_SECONDS — read-silence watchdog: max seconds of
# socket silence on any single read before the call fails (covers long
# thinking-model generation). NOT a total wall-clock deadline — a peer that
# keeps dripping bytes resets the clock. Default 900.
LLM_INACTIVITY_TIMEOUT_SECONDS=900
